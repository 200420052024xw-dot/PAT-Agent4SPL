// controller_ir.json 的中文对照版：结构字段和说明文字使用中文，程序标识符保持原样。
{
  "目标": "由 internal_comms_worker 转换而来的状态驱动控制器。",
  "槽信息": {
    "comm_type": {
      "名称": "comm_type",
      "必填": true,
      "说明": "要生成的内部沟通文档类型；该值决定后续阶段的处理分支。",
      "类型": "enum",
      "默认值": null,
      "枚举值": [
        "newsletter",
        "exec_brief"
      ]
    },
    "email_time_range": {
      "名称": "email_time_range",
      "必填": true,
      "说明": "检索 Gmail 邮件的时间范围，使用自然语言字符串表示，例如 2024-04-01 to 2024-04-30。",
      "类型": "string",
      "默认值": null
    },
    "email_keywords": {
      "名称": "email_keywords",
      "必填": true,
      "说明": "用于搜索 Gmail 邮件的关键词列表，与邮件主题和正文匹配。",
      "类型": "list",
      "默认值": []
    },
    "email_senders": {
      "名称": "email_senders",
      "必填": true,
      "说明": "检索 Gmail 邮件时优先考虑的发件人邮箱地址列表。",
      "类型": "list",
      "默认值": []
    },
    "docs_keywords": {
      "名称": "docs_keywords",
      "必填": true,
      "说明": "用于搜索 Google Docs 的关键词列表，与文档标题和正文匹配。",
      "类型": "list",
      "默认值": []
    },
    "email_evidence": {
      "名称": "email_evidence",
      "必填": true,
      "说明": "从 Gmail 检索到的相关邮件；每项包含发件人、日期、主题和正文摘要。",
      "类型": "list",
      "默认值": []
    },
    "docs_evidence": {
      "名称": "docs_evidence",
      "必填": true,
      "说明": "从 Google Docs 检索到的相关文档；每项包含标题、最后修改时间和内容摘要。",
      "类型": "list",
      "默认值": []
    },
    "newsletter_draft": {
      "名称": "newsletter_draft",
      "必填": true,
      "说明": "根据收集到的邮件和文档证据生成的内部文档正文。",
      "类型": "string",
      "默认值": null,
      "状态结构": {
        "presented": {
          "说明": "生成的文档草稿是否已经展示给用户审阅。",
          "类型": "boolean",
          "默认值": false,
          "转移": [
            {
              "触发条件": {
                "类型": "action_succeeded",
                "动作": "PRESENT_RESULT"
              },
              "设为": true
            }
          ]
        },
        "revised": {
          "说明": "生成的文档草稿是否已经根据用户反馈或策略反馈完成修改。",
          "类型": "boolean",
          "默认值": false,
          "转移": [
            {
              "触发条件": {
                "类型": "action_succeeded",
                "动作": "REVISE_NEWSLETTER"
              },
              "设为": true
            },
            {
              "触发条件": {
                "类型": "action_succeeded",
                "动作": "GENERATE_NEWSLETTER"
              },
              "设为": false
            }
          ]
        }
      }
    }
  },
  "参与者": {
    "console": {
      "交互对象": "human",
      "说明": "用于与用户进行自然语言交互的控制台接口；负责提问、收集输入和展示最终结果。",
      "接口": "program.handler.ConsoleHandler",
      "参与者配置": {
        "io_channel": "@io_channel"
      }
    },
    "google_service": {
      "交互对象": "traditional_system",
      "说明": "封装 Gmail API 和 Google Drive API 的统一接口；接收结构化查询参数，返回匹配的邮件或文档列表。"
    },
    "search_gmail": {
      "交互对象": "traditional_system",
      "说明": "外部系统处理核心。按照日期范围、关键词和发件人列表搜索用户的 Gmail 收件箱。首次调用时执行 InstalledAppFlow OAuth，并按 credentials_path 和 token_path 缓存 Gmail 服务对象，同时支持 HTTP 代理。",
      "接口": "program.handler.SearchGmailHandler",
      "参与者配置": {
        "path_of_credentials": "D:/wu_project/cnlp_studio/cnlp_studio_backend/modules/liu_yang/cnlp_compiler_26_05_28/cnlp_agent/old_controller/internal_comms/credentials.json",
        "path_of_token": "D:/wu_project/cnlp_studio/cnlp_studio_backend/modules/liu_yang/cnlp_compiler_26_05_28/cnlp_agent/old_controller/internal_comms/token.json",
        "proxy_host": "127.0.0.1",
        "proxy_port": 7890
      }
    },
    "search_google_docs": {
      "交互对象": "traditional_system",
      "说明": "外部系统处理核心。搜索用户的 Google Drive，查找正文中包含全部指定关键词的文档，并通过 Docs API 获取匹配文档的纯文本。其 OAuth、缓存和代理方式与 search_gmail 相同。",
      "接口": "program.handler.SearchGoogleDocsHandler",
      "参与者配置": {
        "path_of_credentials": "D:/wu_project/cnlp_studio/cnlp_studio_backend/modules/liu_yang/cnlp_compiler_26_05_28/cnlp_agent/old_controller/internal_comms/credentials.json",
        "path_of_token": "D:/wu_project/cnlp_studio/cnlp_studio_backend/modules/liu_yang/cnlp_compiler_26_05_28/cnlp_agent/old_controller/internal_comms/token.json",
        "proxy_host": "127.0.0.1",
        "proxy_port": 7890
      }
    },
    "generate_newsletter": {
      "交互对象": "traditional_system",
      "说明": "内部动作处理核心。接收邮件列表、文档列表和时间范围，通过一次大模型调用，根据这些材料生成结构化内部简报。",
      "接口": "program.handler.GenerateNewsletterHandler",
      "参与者配置": {
        "api_key": "<API_KEY>",
        "base_url": "https://api.rcouyi.com/v1",
        "model_name": "deepseek-v4-pro"
      }
    },
    "revise_newsletter": {
      "交互对象": "traditional_system",
      "说明": "内部动作处理核心。按照给定的修改要求修改简报。",
      "接口": "program.handler.ReviseNewsletterHandler",
      "参与者配置": {
        "BASE_URL": "https://api.rcouyi.com/v1",
        "OPENAI_API_KEY": "<API_KEY>",
        "OPENAI_MODEL": "deepseek-v4-pro"
      }
    }
  },
  "策略": {
    "newsletter_draft_requirements": {
      "激活条件": "input.slots.newsletter_draft != null",
      "优先级": 1,
      "说明": "newsletter_draft 的正文必须使用英文书写，并且不超过 300 个单词。",
      "参数": {
        "newsletter_draft": "@slot.newsletter_draft"
      }
    }
  },
  "阶段": {
    "collect_requirements": {
      "阶段名称": "collect_requirements",
      "阶段目标": "确定用户需要的沟通文档类型，并收集完整的内部文档检索条件。",
      "阶段指导": "使用 ASK_SLOT 收集 comm_type、email_time_range、email_keywords、email_senders 和 docs_keywords。如果用户通过 ASK_SLOT 提供的值不符合对应槽的要求，使用 ASK_CLARIFY 要求用户提供正确或更合适的值。此情况包括类型或格式错误、超出允许范围、内容不完整，或无法解释为该槽的有效值。不要使用 ASK_CLARIFY 再次确认已经有效的值。收集到的条件必须相互一致，因为它们决定文档的范围和材料来源。",
      "阶段转移": {
        "to_retrieve_evidence": {
          "目标阶段名称": "retrieve_evidence",
          "激活条件": {
            "全部满足": [
              "input.slots.comm_type != null",
              "input.slots.email_time_range != null",
              "input.slots.email_keywords != []",
              "input.slots.email_senders != []",
              "input.slots.docs_keywords != []"
            ]
          }
        }
      },
      "是否初始阶段": true,
      "终止条件": null
    },
    "retrieve_evidence": {
      "阶段名称": "retrieve_evidence",
      "阶段目标": "收集生成内部沟通文档所需的 Gmail 和 Google Docs 证据。",
      "阶段指导": "使用 SEARCH_GMAIL，并传入 email_time_range、email_keywords 和 email_senders，将结果写入 email_evidence；使用 SEARCH_GOOGLE_DOCS，并传入 docs_keywords，将结果写入 docs_evidence。如果检索条件需要修正，或者搜索结果说明当前范围不足，使用 ASK_CLARIFY，并返回相关需求的收集步骤，然后重新检索证据。",
      "阶段转移": {
        "to_generate_document": {
          "目标阶段名称": "generate_document",
          "激活条件": {
            "全部满足": [
              "input.slots.email_evidence != []",
              "input.slots.docs_evidence != []",
              "input.slots.comm_type != null",
              "input.slots.email_time_range != null"
            ]
          }
        }
      },
      "是否初始阶段": false,
      "终止条件": null
    },
    "generate_document": {
      "阶段名称": "generate_document",
      "阶段目标": "根据收集到的证据和指定的时间范围，生成有依据的 newsletter 或 executive brief。",
      "阶段指导": "使用 GENERATE_NEWSLETTER，并传入 email_evidence、docs_evidence、email_time_range 和 comm_type，生成 newsletter_draft。草稿必须符合所选沟通类型，并且同时以两类证据为依据。如果必要输入或证据已经不足，说明问题并返回适当的前置阶段。",
      "阶段转移": {
        "to_present_draft": {
          "目标阶段名称": "present_draft",
          "激活条件": {
            "全部满足": [
              "input.slots.newsletter_draft != null",
              "input.slots.comm_type != null",
              "input.slots.email_time_range != null",
              "input.slots.email_evidence != []",
              "input.slots.docs_evidence != []"
            ]
          }
        },
        "to_revise": {
          "目标阶段名称": "revise",
          "激活条件": "contains(input.policy_feedback, \"DENY\")"
        }
      },
      "是否初始阶段": false,
      "终止条件": null
    },
    "present_draft": {
      "阶段名称": "present_draft",
      "阶段目标": "将完成的内部沟通文档草稿交付给用户。",
      "阶段指导": "使用 PRESENT_RESULT 向用户展示 newsletter_draft。将草稿视为任务产物；如果用户提出的实质性反馈要求修改需求、重新检索证据或重新生成文档，应先澄清反馈。",
      "终止条件": {
        "激活条件": {
          "全部满足": [
            "input.slots.newsletter_draft != null",
            "input.slot_states.newsletter_draft.presented == true",
            "contains(input.policy_feedback, \"ALLOW\")"
          ]
        }
      },
      "是否初始阶段": false,
      "阶段转移": null
    },
    "revise": {
      "阶段名称": "revise",
      "阶段目标": "当策略反馈要求生成新版本时，修改已展示的 newsletter_draft。",
      "阶段指导": "如果存在策略反馈，使用 REVISE_NEWSLETTER，并传入 newsletter_draft 和 policy_feedback 来更新 newsletter_draft。修改完成后返回 present_draft，再次展示修改后的草稿。",
      "阶段转移": {
        "to_present_draft": {
          "目标阶段名称": "present_draft",
          "激活条件": "input.slot_states.newsletter_draft.revised == true"
        }
      },
      "是否初始阶段": false,
      "终止条件": null
    }
  },
  "动作": {
    "ASK_SLOT": {
      "名称": "ASK_SLOT",
      "说明": "要求用户提供与任务相关的槽值。",
      "执行者": "console",
      "激活条件": {
        "全部满足": [
          "input.current_stage == \"collect_requirements\"",
          {
            "任一满足": [
              "input.slots.comm_type == null",
              "input.slots.email_time_range == null",
              "input.slots.email_keywords == []",
              "input.slots.email_senders == []",
              "input.slots.docs_keywords == []"
            ]
          }
        ]
      },
      "参数": {
        "slot_name": {
          "参数名称": "slot_name",
          "参数说明": "需要向用户询问取值的槽。",
          "必填": true,
          "参数类型": "string"
        }
      },
      "执行核心": "ask_slot"
    },
    "PRESENT_RESULT": {
      "名称": "PRESENT_RESULT",
      "说明": "向用户展示结果、消息、草稿、任务产物或最终输出。",
      "执行者": "console",
      "激活条件": {
        "全部满足": [
          "input.current_stage == \"present_draft\"",
          "input.slots.newsletter_draft != null",
          "input.slot_states.newsletter_draft.presented == false"
        ]
      },
      "参数": {
        "content": {
          "参数名称": "content",
          "参数说明": "需要向用户展示的内容。",
          "必填": true,
          "参数类型": "string"
        }
      },
      "执行核心": "present_result"
    },
    "SEARCH_GMAIL": {
      "名称": "SEARCH_GMAIL",
      "说明": "按照选定的日期范围、关键词和优先发件人地址，为内部沟通文档检索相关 Gmail 证据。",
      "执行者": "search_gmail",
      "激活条件": {
        "全部满足": [
          "input.current_stage == \"retrieve_evidence\"",
          "input.slots.comm_type != null",
          "input.slots.email_time_range != null",
          "input.slots.email_keywords != []",
          "input.slots.email_senders != []",
          "input.slots.email_evidence == []"
        ]
      },
      "参数": {
        "date_range": {
          "参数名称": "date_range",
          "参数说明": "Gmail 检索时间范围，取自控制器状态变量 email_time_range。",
          "必填": true,
          "参数类型": "string"
        },
        "keywords": {
          "参数名称": "keywords",
          "参数说明": "用于搜索 Gmail 主题和正文的关键词列表，取自控制器状态变量 email_keywords。",
          "必填": true,
          "参数类型": "list"
        },
        "sender": {
          "参数名称": "sender",
          "参数说明": "优先发件人邮箱地址列表，取自控制器状态变量 email_senders。",
          "必填": true,
          "参数类型": "list"
        }
      },
      "执行核心": "SEARCH_GMAIL"
    },
    "SEARCH_GOOGLE_DOCS": {
      "名称": "SEARCH_GOOGLE_DOCS",
      "说明": "使用选定关键词搜索文档标题和正文，为内部沟通文档检索相关 Google Docs 证据。",
      "执行者": "search_google_docs",
      "激活条件": {
        "全部满足": [
          "input.current_stage == \"retrieve_evidence\"",
          "input.slots.comm_type != null",
          "input.slots.docs_keywords != []",
          "input.slots.docs_evidence == []"
        ]
      },
      "参数": {
        "keywords": {
          "参数名称": "keywords",
          "参数说明": "Google Docs 搜索关键词列表，取自控制器状态变量 docs_keywords。",
          "必填": true,
          "参数类型": "list"
        }
      },
      "执行核心": "search_google_docs"
    },
    "GENERATE_NEWSLETTER": {
      "名称": "GENERATE_NEWSLETTER",
      "说明": "根据检索到的 Gmail 和 Google Docs 证据、指定时间范围及沟通类型，生成有依据的内部 newsletter 或 executive brief。",
      "执行者": "generate_newsletter",
      "激活条件": {
        "全部满足": [
          "input.current_stage == \"generate_document\"",
          "input.slots.comm_type != null",
          "input.slots.email_time_range != null",
          "input.slots.email_evidence != []",
          "input.slots.docs_evidence != []",
          "input.slots.newsletter_draft == null"
        ]
      },
      "参数": {
        "email_evidence": {
          "参数名称": "email_evidence",
          "参数说明": "检索到的 Gmail 证据，取自控制器状态变量 email_evidence。",
          "必填": true,
          "参数类型": "list"
        },
        "docs_evidence": {
          "参数名称": "docs_evidence",
          "参数说明": "检索到的 Google Docs 证据，取自控制器状态变量 docs_evidence。",
          "必填": true,
          "参数类型": "list"
        },
        "email_time_range": {
          "参数名称": "email_time_range",
          "参数说明": "内部沟通文档覆盖的时间范围，取自控制器状态变量 email_time_range。",
          "必填": true,
          "参数类型": "string"
        },
        "comm_type": {
          "参数名称": "comm_type",
          "参数说明": "用户选择的内部沟通文档类型 newsletter 或 exec_brief，取自控制器状态变量 comm_type。",
          "必填": true,
          "参数类型": "string"
        }
      },
      "执行核心": "generate_newsletter"
    },
    "REVISE_NEWSLETTER": {
      "名称": "REVISE_NEWSLETTER",
      "说明": "根据策略反馈或用户提出的修改要求以及已检索的证据修改 newsletter_draft，并将结果写回 newsletter_draft。",
      "执行者": "revise_newsletter",
      "激活条件": {
        "全部满足": [
          "input.current_stage == \"revise\"",
          "input.slots.newsletter_draft != null",
          "contains(input.policy_feedback, \"DENY\")"
        ]
      },
      "参数": {
        "newsletter_draft": {
          "参数名称": "newsletter_draft",
          "参数说明": "当前简报草稿，取自 newsletter_draft。",
          "必填": true,
          "参数类型": "string"
        },
        "policy_feedback": {
          "参数名称": "policy_feedback",
          "参数说明": "修改要求，取自策略反馈或最近一次控制台用户输入。",
          "必填": true,
          "参数类型": "string"
        }
      },
      "执行核心": "revise_newsletter"
    }
  }
}
