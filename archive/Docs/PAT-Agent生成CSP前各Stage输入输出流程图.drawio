eWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="step11" target="out11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step11" target="step12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="in12" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;输入&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;通用说明 + 语法提示 + 参考示例 + 原始系统描述 + 完整计划&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="2125" width="445" height="136" as="geometry"/></mxCell><mxCell id="step12" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Stage 5.3｜组装 Claude prompt&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;按固定顺序连接，构造单条 user 消息正文&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="530" y="2125" width="465" height="136" as="geometry"/></mxCell><mxCell id="out12" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;final_code_gen_prompt；未附加整个 history 或独立 context&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1040" y="2125" width="510" height="136" as="geometry"/></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="in12" target="step12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="step12" target="out12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step12" target="step13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="in13" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;输入&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;final_code_gen_prompt&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="2285" width="445" height="136" as="geometry"/></mxCell><mxCell id="step13" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Stage 5.4｜生成 CSP#  ⑤&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;Claude 生成回复；helper 读取首个内容块文本&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF1E6;strokeColor=#D48B47;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="530" y="2285" width="465" height="136" as="geometry"/></mxCell><mxCell id="out13" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;原始回复字符串；写 claude-code.json 的 answerClaude（PAT 字段此时为空）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1040" y="2285" width="510" height="136" as="geometry"/></mxCell><mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="in13" target="step13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="step13" target="out13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step13" target="step14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="in14" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;输入&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;claude-code.json 最后一条 answerClaude&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="2445" width="445" height="136" as="geometry"/></mxCell><mxCell id="step14" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Stage 5.后处理｜提取并落盘&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;选字符数最长的 Markdown 代码块；无围栏则用全文去首尾空白&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="530" y="2445" width="465" height="136" as="geometry"/></mxCell><mxCell id="out14" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;original_llm_response.txt + extracted_code.csp；候选代码，下一步才进入 PAT 验证&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1040" y="2445" width="510" height="136" as="geometry"/></mxCell><mxCell id="e57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="in14" target="step14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="step14" target="out14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;关键边界&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;assertions 由输入预先给定；Stage 4.3 只生成文字，实际 #assert 由 Claude 生成。&lt;br&gt;context 是日志字段；实际模型输入是 messages 中的 content，history 不会自动成为上下文。&lt;br&gt;该图展示正常主线。JSON 正文解析失败可能保留原串；缺失 / 损坏 / 空 history 会跳过任务。详见源文档。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFAE8;strokeColor=#D5BA55;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="2635" width="1510" height="160" as="geometry"/></mxCell><mxCell id="ft" value="02 / Stage 输入输出明细     ①–④ 为 Planning LLM；⑤ 为 Claude；.1 / .2 等是文档细分编号。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#55677E;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="2810" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="03 motor_demo示例"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1525" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="motor_demo · 一份信息如何变成 CSP#" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontColor=#19334F;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1480" height="60" as="geometry"/></mxCell><mxCell id="s" value="下面只摘取代表性字段与代码；六种动作是可选择的行为集合，不是固定执行顺序。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#55677E;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="1480" height="45" as="geometry"/></mxCell><mxCell id="h0" value="① 原始描述 / 输入字段" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#19334F;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="365" height="60" as="geometry"/></mxCell><mxCell id="h1" value="② Planning 提取的 JSON" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#19334F;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="425" y="170" width="365" height="60" as="geometry"/></mxCell><mxCell id="h2" value="③ 自然语言建模计划" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#19334F;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="810" y="170" width="365" height="60" as="geometry"/></mxCell><mxCell id="h3" value="④ Claude 生成的 CSP#" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#19334F;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1195" y="170" width="365" height="60" as="geometry"/></mxCell><mxCell id="rawdata" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;状态与初值&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;发动机：关闭 / 开启&lt;br&gt;车辆：停止 / 移动&lt;br&gt;燃油：空 / 满&lt;br&gt;初始：关闭、停止、满油&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="345" height="250" as="geometry"/></mxCell><mxCell id="jsondata" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;常量 / 变量 JSON&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;constants: ENGINE_OFF = 0&lt;br&gt;ENGINE_ON = 1（共六个常量）&lt;br&gt;variables:&lt;br&gt;name: engine; type: int&lt;br&gt;initialValue: ENGINE_OFF&lt;br&gt;另有 car、fuel&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#7182D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="425" y="255" width="345" height="250" as="geometry"/></mxCell><mxCell id="nldata" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;data1 · 数据注释&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;// ENGINE_OFF：关闭，值为 0&lt;br&gt;// ENGINE_ON：开启，值为 1&lt;br&gt;// engine：记录发动机状态，&lt;br&gt;// 初始值为 ENGINE_OFF&lt;br&gt;（其余常量变量同样逐行描述）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#7182D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="810" y="255" width="345" height="250" as="geometry"/></mxCell><mxCell id="cspdata" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;常量 / 变量代码&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;#define ENGINE_OFF 0;&lt;br&gt;#define ENGINE_ON 1;&lt;br&gt;var engine = ENGINE_OFF;&lt;br&gt;var car = CAR_STOPPED;&lt;br&gt;var fuel = FUEL_FULL;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF1E6;strokeColor=#D48B47;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1195" y="255" width="345" height="250" as="geometry"/></mxCell><mxCell id="rawact" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;启动发动机&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;条件：发动机关闭且有满油&lt;br&gt;动作：start_engine&lt;br&gt;变化：发动机开启&lt;br&gt;其余动作：stop_engine、&lt;br&gt;start_driving、stop_driving、&lt;br&gt;consume_fuel、refuel&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="345" height="275" as="geometry"/></mxCell><mxCell id="jsonact" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;动作 JSON（摘录）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;action_name: start_engine&lt;br&gt;conditions:&lt;br&gt;  engine: ENGINE_OFF&lt;br&gt;  fuel: FUEL_FULL&lt;br&gt;state_changes:&lt;br&gt;  engine: ENGINE_ON&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#7182D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="425" y="590" width="345" height="275" as="geometry"/></mxCell><mxCell id="nlact" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;data2 · 动作注释&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;// 定义 motor 子系统&lt;br&gt;// 若 engine 为 ENGINE_OFF&lt;br&gt;// 且 fuel 为 FUEL_FULL，&lt;br&gt;// start_engine 动作使&lt;br&gt;// engine 变为 ENGINE_ON。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#7182D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="810" y="590" width="345" height="275" as="geometry"/></mxCell><mxCell id="cspact" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;守卫 / 事件 / 更新&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;motor() =&lt;br&gt;  ([engine == ENGINE_OFF&lt;br&gt;    &amp;amp;&amp;amp; fuel == FUEL_FULL]&lt;br&gt;    start_engine{&lt;br&gt;      engine = ENGINE_ON;&lt;br&gt;    } -&amp;gt; motor())&lt;br&gt;  [] 其他五个动作分支;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF1E6;strokeColor=#D48B47;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1195" y="590" width="345" height="275" as="geometry"/></mxCell><mxCell id="rawassert" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;输入中的 assertions&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;deadlock-free&lt;br&gt;reachability / customize&lt;br&gt;stateName: drivewithoutfuel&lt;br&gt;customDescription:&lt;br&gt;车在移动，但燃油为空&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="345" height="250" as="geometry"/></mxCell><mxCell id="codeassert" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Stage 3 → Stage 4.3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;code 直接读取断言对象&lt;br&gt;按固定模板写成说明&lt;br&gt;此处没有“生成断言”的 LLM&lt;br&gt;interactionMode 提供组合方式&lt;br&gt;单子系统无需额外交错对象&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="425" y="950" width="345" height="250" as="geometry"/></mxCell><mxCell id="nlassert" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;data3 · 系统 / 检查说明&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;// 定义 motor_demo 系统&lt;br&gt;// 检查系统无死锁&lt;br&gt;// 定义 drivewithoutfuel：&lt;br&gt;// 车在移动且燃油为空&lt;br&gt;// 检查该状态是否可达&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="810" y="950" width="345" height="250" as="geometry"/></mxCell><mxCell id="cspassert" value="&lt;div style=&quot;font-size:16px&quot;&gt;&lt;b&gt;系统 / 谓词 / 断言&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;motor_demo = motor();&lt;br&gt;#define drivewithoutfuel&lt;br&gt;  (car == CAR_MOVING&lt;br&gt;   &amp;amp;&amp;amp; fuel == FUEL_EMPTY);&lt;br&gt;#assert motor_demo deadlockfree;&lt;br&gt;#assert motor_demo reaches&lt;br&gt;  drivewithoutfuel;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF1E6;strokeColor=#D48B47;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=14;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1195" y="950" width="345" height="250" as="geometry"/></mxCell><mxCell id="e59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rawdata" target="jsondata"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="jsondata" target="nldata"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nldata" target="cspdata"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rawact" target="jsonact"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="jsonact" target="nlact"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nlact" target="cspact"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rawassert" target="codeassert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="codeassert" target="nlassert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nlassert" target="cspassert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="merge" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 4.4 → Stage 5：三段计划共同进入一次 Claude 调用&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;data1 + data2 + data3 → 完整计划；结合参考示例、语法提示和原始描述 → Claude prompt。&lt;br&gt;右列是同一份 CSP# 的不同组成部分，并非三次独立生成。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="810" y="1280" width="730" height="130" as="geometry"/></mxCell><mxCell id="warn" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;示例与验证边界&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;assertionTruth（Valid / Invalid）只供后续验证结果比较，不进入生成 prompt。&lt;br&gt;上述内容为文档的说明性示例 / 摘录，没有运行模型，也没有宣称通过 PAT。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFAE8;strokeColor=#D5BA55;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="730" height="130" as="geometry"/></mxCell><mxCell id="f" value="03 / 表示转换示例     完整 JSON、完整 prompt 与完整 CSP# 请查看同目录源 Markdown。
所有卡片、文字和连线均可在 draw.io 中单独编辑。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#55677E;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="1435" width="1480" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>