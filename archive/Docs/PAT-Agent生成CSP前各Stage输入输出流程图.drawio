dth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=19;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="750" y="165" width="335" height="1265" as="geometry"/></mxCell><mxCell id="lane3" value="&lt;div style=&quot;font-size:21px&quot;&gt;&lt;b&gt;Coding-Agent&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=19;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1105" y="165" width="335" height="1265" as="geometry"/></mxCell><mxCell id="task" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;原始任务 · PAT.json&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;motor_demo / motor 子系统&lt;br&gt;状态、初值、六个动作的描述&lt;br&gt;interactionMode = interleaving&lt;br&gt;预先给定 assertions&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="295" height="185" as="geometry"/></mxCell><mxCell id="init" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 0 · 初始化&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;配置 → 两个模型客户端&lt;br&gt;读取当前任务对象&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="770" y="245" width="295" height="140" as="geometry"/></mxCell><mxCell id="p1" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 1 · 提数据  ①&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;子系统描述 + 组合模式&lt;br&gt;→ 常量 / 变量 JSON 字符串&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#7182D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="415" y="445" width="295" height="135" as="geometry"/></mxCell><mxCell id="post1" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 1.后处理&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;回读 const-history.json&lt;br&gt;→ 字符串 + 解析对象&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="770" y="445" width="295" height="135" as="geometry"/></mxCell><mxCell id="p2" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 2 · 提动作  ②&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;系统描述 + 常量变量对象&lt;br&gt;→ 动作 JSON 字符串&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#7182D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="415" y="635" width="295" height="135" as="geometry"/></mxCell><mxCell id="post3" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 3 · 准备输入&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;回读动作 history&lt;br&gt;读取原输入 assertions&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="770" y="635" width="295" height="135" as="geometry"/></mxCell><mxCell id="p4" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 4.1 / 4.2  ③④&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;常量变量 JSON → 数据注释&lt;br&gt;动作 JSON → 动作注释&lt;br&gt;两次独立、顺序调用&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#7182D4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="415" y="835" width="295" height="155" as="geometry"/></mxCell><mxCell id="p43" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 4.3 · 模板拼接&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;modelName + 组合模式&lt;br&gt;+ 原输入中的断言&lt;br&gt;→ 系统 / 谓词 / 断言说明&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="770" y="835" width="295" height="155" as="geometry"/></mxCell><mxCell id="plan" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 4.4 + 后处理&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;合并 data1 + data2 + data3&lt;br&gt;保存并回读完整计划&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="770" y="1055" width="295" height="130" as="geometry"/></mxCell><mxCell id="assembly" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 5.1–5.3 · code&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;TF-IDF 检索 + 语法提示&lt;br&gt;+ 原始描述 + 计划 → prompt&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1125" y="1055" width="295" height="130" as="geometry"/></mxCell><mxCell id="claude" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 5.4 · Claude  ⑤&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;完整 prompt → 含 CSP# 回复&lt;br&gt;保存 claude-code.json&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF1E6;strokeColor=#D48B47;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1125" y="1250" width="295" height="135" as="geometry"/></mxCell><mxCell id="save" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Stage 5.后处理&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;回读回复 → 提取最长代码块&lt;br&gt;→ extracted_code.csp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="770" y="1250" width="295" height="135" as="geometry"/></mxCell><mxCell id="bounds" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;阅读边界&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;①–⑤：模型调用编号&lt;br&gt;绿色：确定性代码处理&lt;br&gt;蓝紫：Planning LLM&lt;br&gt;橙色：Claude&lt;br&gt;实线：结果流 / 下一步&lt;br&gt;虚线：复用原输入或补充材料&lt;br&gt;到候选 CSP# 为止；未验证&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFAE8;strokeColor=#D5BA55;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="60" y="1055" width="295" height="285" as="geometry"/></mxCell><mxCell id="assert" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;检查要求来自输入&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;无死锁；坏状态可达性&lt;br&gt;assertionTruth 留待后续比较&lt;br&gt;本段不发送期望 Valid/Invalid&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFAE8;strokeColor=#D5BA55;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="60" y="835" width="295" height="155" as="geometry"/></mxCell><mxCell id="original" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;原始系统描述&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;modelDesc + 子系统描述&lt;br&gt;Stage 2 与 Stage 5.3 复用&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="60" y="635" width="295" height="135" as="geometry"/></mxCell><mxCell id="support" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;代码生成的外部材料&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;database-rag-claude.json&lt;br&gt;参考注释 + 配套 CSP#&lt;br&gt;syntax-dataset.json&lt;br&gt;general_info / pitfalls_rules&lt;br&gt;仅提供参考和语法文字&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1125" y="635" width="295" height="230" as="geometry"/></mxCell><mxCell id="e1" value="当前任务" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="task" target="init"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endF