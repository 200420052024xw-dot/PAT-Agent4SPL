&gt;&lt;b&gt;输入&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;API key 环境变量；PAT.json 任务数组&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="445" height="136" as="geometry"/></mxCell><mxCell id="step0" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Stage 0｜加载配置与输入&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;创建客户端，取出当前任务；此时不调用模型&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="530" y="205" width="465" height="136" as="geometry"/></mxCell><mxCell id="out0" value="&lt;div style=&quot;font-size:17px&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;line-height:1.5&quot;&gt;current_structured_data：motor_demo 原始对象&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7FB;strokeColor=#9CAFC4;strokeWidth=1.5;align=left;verticalAlign=top;spacing=15;fontSize=15;fontColor=#20334C;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1040" y="205" width="510" height="136" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="in0" target="step0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#54708D;dashed=0;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FF