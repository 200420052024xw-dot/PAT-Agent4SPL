<mxfile host="Electron" modified="2026-09-14T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="controller-ir-to-csp-merged" name="ControllerIR到CSPSharp-代码合并版">
    <mxGraphModel dx="4240" dy="2910" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="1890" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=50;fontStyle=1;fontColor=#19334F;fontFamily=Microsoft YaHei;" value="PAT-Agent：ControllerIR 到 CSP# 的确定性转换流程" vertex="1"><mxGeometry x="55" y="25" width="3090" height="70" as="geometry" /></mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=28;fontColor=#55677E;fontFamily=Microsoft YaHei;" value="代码合并版｜主线只保留输入适配、核心转换、IR 边界和确定性渲染；右侧明确展示两次 LLM 调用的位置、输入与输出" vertex="1"><mxGeometry x="55" y="100" width="3090" height="58" as="geometry" /></mxCell>
        <mxCell id="band1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#F7F9FC;strokeColor=#B9C5D3;strokeWidth=2;" value="" vertex="1"><mxGeometry x="40" y="180" width="3120" height="330" as="geometry" /></mxCell>
        <mxCell id="band1title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=35;fontStyle=1;fontColor=#19334F;fontFamily=Microsoft YaHei;" value="阶段一｜输入边界：把多种 ControllerIR 统一成可信对象" vertex="1"><mxGeometry x="70" y="195" width="1500" height="52" as="geometry" /></mxCell>
        <mxCell id="input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E7F1FB;strokeColor=#4A78A8;strokeWidth=3.5;align=left;verticalAlign=top;spacing=18;fontColor=#20334C;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:33px&quot;&gt;&lt;b&gt;ControllerIR 输入&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:25px;line-height:1.42;margin-top:12px&quot;&gt;JSON / JSONC，中英文 schema 均可&lt;br&gt;&lt;b&gt;业务事实：&lt;/b&gt;goal · slots · participants · policies · stages · actions&lt;/div&gt;" vertex="1"><mxGeometry x="90" y="275" width="850" height="175" as="geometry" /></mxCell>
        <mxCell id="adapter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=3.5;align=left;verticalAlign=top;spacing=18;fontColor=#20334C;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:33px&quot;&gt;&lt;b&gt;输入适配模块　input.py&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:25px;line-height:1.42;margin-top:12px&quot;&gt;&lt;b&gt;解析：&lt;/b&gt;去除 JSONC 注释和尾逗号　　&lt;b&gt;归一化：&lt;/b&gt;中文键递归映射到英文执行 schema　　&lt;b&gt;校验：&lt;/b&gt;检查六类顶层字段、唯一初始阶段及阶段引用&lt;br&gt;&lt;b&gt;输出：&lt;/b&gt;规范化 ControllerIR；结构错误在入口直接停止，不进入后续转换&lt;/div&gt;" vertex="1"><mxGeometry x="1010" y="275" width="2100" height="175" as="geometry" /></mxCell>
        <mxCell id="band2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#F7F9FC;strokeColor=#B9C5D3;strokeWidth=2;" value="" vertex="1"><mxGeometry x="40" y="550" width="3120" height="850" as="geometry" /></mxCell>
        <mxCell id="band2title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=35;fontStyle=1;fontColor=#19334F;fontFamily=Microsoft YaHei;" value="阶段二｜核心转换：相关代码合并为一个编排模块" vertex="1"><mxGeometry x="70" y="565" width="1450" height="52" as="geometry" /></mxCell>
        <mxCell id="core" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=4;align=left;verticalAlign=top;spacing=22;fontColor=#20334C;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:36px&quot;&gt;&lt;b&gt;核心转换器　pipeline.py&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#55677E;margin-top:4px&quot;&gt;内部调用 abstraction.py · conditions.py · transitions.py；这些实现细节不再拆成主流程节点&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;margin-top:18px;font-size:24px;line-height:1.38&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:32%;vertical-align:top;padding:12px 18px;border:1px solid #9FCFC2&quot;&gt;&lt;b style=&quot;font-size:28px&quot;&gt;A · 有限状态数据模型&lt;/b&gt;&lt;br&gt;enum → UNSET + 枚举值&lt;br&gt;string → UNSET / SET&lt;br&gt;list → EMPTY / NONEMPTY&lt;br&gt;state_schema → bool&lt;br&gt;stages → STAGE_* + current_stage&lt;/td&gt;&lt;td style=&quot;width:36%;vertical-align:top;padding:12px 18px;border:1px solid #9FCFC2&quot;&gt;&lt;b style=&quot;font-size:28px&quot;&gt;B · 行为与转移编译&lt;/b&gt;&lt;br&gt;all_of / any_of / not → CSP# 守卫&lt;br&gt;action + effects → 子系统 Transition&lt;br&gt;展开 ASK_SLOT；建 stage / policy / termination 转移&lt;br&gt;未知语义进入 unresolved，不把原文混入 CSP#&lt;br&gt;&lt;b style=&quot;color:#5B55A4&quot;&gt;★ 调用 1：构造 traditional_system 动作 Transition 时&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;width:32%;vertical-align:top;padding:12px 18px;border:1px solid #9FCFC2&quot;&gt;&lt;b style=&quot;font-size:28px&quot;&gt;C · 进程、系统与基础检查&lt;/b&gt;&lt;br&gt;按 executor 聚合子系统进程&lt;br&gt;追加 workflow_controller / policy_checker&lt;br&gt;多进程用 ||| 交错组合&lt;br&gt;生成无死锁、完成可达、最终完成断言&lt;br&gt;&lt;b style=&quot;color:#5B55A4&quot;&gt;★ 调用 2：基础 CSP_IR 建成后、最终校验前&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:26px;line-height:1.4;margin-top:16px&quot;&gt;&lt;b&gt;合并输出：&lt;/b&gt;constants + variables + process + transitions + system + predicates + assertions&lt;/div&gt;" vertex="1"><mxGeometry x="90" y="660" width="2020" height="500" as="geometry" /></mxCell>
        <mxCell id="llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#6574C4;strokeWidth=3.5;align=left;verticalAlign=top;spacing=16;fontColor=#20334C;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:31px&quot;&gt;&lt;b&gt;两次 LLM 调用　llm.py → OpenAICompatibleLLM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.36;margin-top:10px&quot;&gt;&lt;b style=&quot;font-size:24px;color:#493A77&quot;&gt;调用 1 · infer_effects（build_transitions 内）&lt;/b&gt;&lt;br&gt;&lt;b&gt;输入：&lt;/b&gt;action_name / action；相关 stages；participant 的 interactive_object、description、interface；slots；available_variables(name,type,options)；code_derived_effects&lt;br&gt;&lt;b&gt;输出：&lt;/b&gt;Effect[] = {variable, value}；代码校验变量和值域，并与已有 effects 无冲突合并&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:24px;color:#493A77&quot;&gt;调用 2 · propose_checks（基础 CSP_IR 建成后）&lt;/b&gt;&lt;br&gt;&lt;b&gt;输入：&lt;/b&gt;goal、policies；variables / constants / processes / events / transitions；existing_predicates / existing_assertions；system_name&lt;br&gt;&lt;b&gt;输出：&lt;/b&gt;Predicate[] + Assertion[]（最多各 3 个，reachability / LTL）；代码再次校验引用、类型和公式标识符&lt;br&gt;&lt;br&gt;&lt;b&gt;调用约束：&lt;/b&gt;temperature=0、JSON 对象、最多 2 次尝试；participant_config 不发送；--offline 跳过两次调用&lt;/div&gt;" vertex="1"><mxGeometry x="2180" y="660" width="930" height="500" as="geometry" /></mxCell>
        <mxCell id="ir" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E7F1FB;strokeColor=#4A78A8;strokeWidth=3.5;align=left;verticalAlign=top;spacing=14;fontColor=#20334C;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:29px&quot;&gt;&lt;b&gt;CSP_IR 边界　models/csp_ir.py&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.35;margin-top:8px&quot;&gt;Pydantic 集中校验标识符、唯一性、跨字段引用、类型 / 值域、进程参数及断言载荷。&lt;br&gt;&lt;b&gt;产物：&lt;/b&gt;*.csp_ir.json + conversion_report.json；在线模式另存 llm_trace.json&lt;/div&gt;" vertex="1"><mxGeometry x="2180" y="1190" width="930" height="160" as="geometry" /></mxCell>
        <mxCell id="band3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFF9F1;strokeColor=#D7B584;strokeWidth=2;" value="" vertex="1"><mxGeometry x="40" y="1440" width="3120" height="350" as="geometry" /></mxCell>
        <mxCell id="band3title" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=35;fontStyle=1;fontColor=#6D4925;fontFamily=Microsoft YaHei;" value="阶段三｜确定性输出：经校验的 CSP_IR 一次性渲染为 CSP#" vertex="1"><mxGeometry x="70" y="1455" width="1650" height="52" as="geometry" /></mxCell>
        <mxCell id="renderer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF7F3;strokeColor=#299B80;strokeWidth=3.5;align=left;verticalAlign=top;spacing=17;fontColor=#20334C;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:31px&quot;&gt;&lt;b&gt;确定性渲染器　renderer.py&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;line-height:1.4;margin-top:10px&quot;&gt;固定顺序：#define 常量 → var 变量 → 进程分支 → System 组合 → predicates → #assert&lt;br&gt;Transition： [guard] event {effects} -&amp;gt; next_process&lt;/div&gt;" vertex="1"><mxGeometry x="90" y="1545" width="1000" height="170" as="geometry" /></mxCell>
        <mxCell id="csp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E7F1FB;strokeColor=#4A78A8;strokeWidth=4;align=left;verticalAlign=top;spacing=17;fontColor=#20334C;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:33px&quot;&gt;&lt;b&gt;生成 *.csp&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;line-height:1.4;margin-top:10px&quot;&gt;完整、可追溯的 CSP# 文本&lt;br&gt;不依赖 LLM 自由文本格式&lt;/div&gt;" vertex="1"><mxGeometry x="1160" y="1545" width="760" height="170" as="geometry" /></mxCell>
        <mxCell id="pat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF1E6;strokeColor=#D48B47;strokeWidth=3;align=left;verticalAlign=top;spacing=17;fontColor=#20334C;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:30px&quot;&gt;&lt;b&gt;可选 --verify&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.4;margin-top:10px&quot;&gt;逐断言运行 PAT&lt;br&gt;输出 verification.json&lt;/div&gt;" vertex="1"><mxGeometry x="1990" y="1545" width="560" height="170" as="geometry" /></mxCell>
        <mxCell id="end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#E4F6EA;strokeColor=#2D9B57;strokeWidth=4;align=center;verticalAlign=middle;spacing=16;fontColor=#1E5F38;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:31px&quot;&gt;&lt;b&gt;CSP# + 可追溯产物&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:22px;margin-top:9px&quot;&gt;可直接交给 PAT 或后续修复流水线&lt;/div&gt;" vertex="1"><mxGeometry x="2620" y="1545" width="490" height="170" as="geometry" /></mxCell>
        <mxCell id="foot" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=23;fontColor=#55677E;fontFamily=Microsoft YaHei;" value="图例：蓝色 = 输入 / 稳定产物；绿色 = 合并后的确定性代码模块；紫色 = 两次可选 LLM 调用（--offline 跳过）；橙色 = 可选 PAT 验证。当前测试样例离线转换：26 常量、12 变量、7 进程、25 转移、3 条基础断言。" vertex="1"><mxGeometry x="55" y="1815" width="3090" height="45" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="input" target="adapter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#526D89;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="adapter" target="core" value="规范化 ControllerIR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#526D89;fontSize=22;fontColor=#3E5873;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.45;exitY=1;entryX=0.45;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="core" target="llm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#6574C4;dashed=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="llm" target="ir" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#6574C4;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="core" target="ir" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#526D89;exitX=1;exitY=0.78;entryX=0;entryY=0.6;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="ir" target="renderer" value="经校验的 CSP_IR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#526D89;fontSize=22;fontColor=#3E5873;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="renderer" target="csp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#526D89;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="csp" target="end" value="主交付路径" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#526D89;fontSize=21;fontColor=#3E5873;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.25;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="1755" /><mxPoint x="2740" y="1755" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="csp" target="pat" value="可选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#D48B47;dashed=1;fontSize=21;fontColor=#6D4925;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="pat" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#D48B47;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
